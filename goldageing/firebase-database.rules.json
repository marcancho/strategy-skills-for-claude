{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": false,
      ".write": false
    },

    "submissions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["submittedAt", "status"],

      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['tipo', 'entidade', 'distrito', 'concelho', 'nome', 'email', 'telefone', 'maturidade', 'descricao', 'referencia', 'consentimentoRGPD', 'consentimentoRGPDData', 'status', 'submittedAt'])",

        "tipo": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "entidade": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 160" },
        "nif": { ".validate": "newData.isString() && newData.val().matches(/^([1-9][0-9]{8})?$/)" },
        "colaboradores": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "distrito": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "concelho": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "website": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "nome": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 120" },
        "cargo": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 160 && newData.val().matches(/^[^ @]+@[^ @]+[.][^ @]+$/)" },
        "telefone": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "preferenciaContacto": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "servicos": {
          "$i": { ".validate": "newData.isString() && newData.val().length <= 100" }
        },
        "publicoAlvo": {
          "$i": { ".validate": "newData.isString() && newData.val().length <= 100" }
        },
        "maturidade": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "prazo": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "descricao": { ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 2000" },
        "referencia": { ".validate": "newData.isString() && newData.val().matches(/^GA-[0-9]{8}-[0-9A-F]{6}$/)" },
        "consentimentoRGPD": { ".validate": "newData.val() === true" },
        "consentimentoRGPDData": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "consentimentoMarketing": { ".validate": "newData.isBoolean()" },
        "origem": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "submittedAt": { ".validate": "newData.isString() && newData.val().length <= 30" },

        "status": {
          ".validate": "newData.isString() && (newData.val() === 'nova' || (auth != null && root.child('admins').child(auth.uid).val() === true && newData.val().matches(/^(em_analise|aprovada|rejeitada)$/)))"
        },
        "adminNotes": {
          ".validate": "auth != null && root.child('admins').child(auth.uid).val() === true && newData.isString() && newData.val().length <= 5000"
        },
        "updatedAt": {
          ".validate": "auth != null && root.child('admins').child(auth.uid).val() === true && newData.isString() && newData.val().length <= 30"
        },

        "$other": { ".validate": false }
      }
    }
  }
}
